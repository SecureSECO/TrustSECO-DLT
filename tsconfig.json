{
	"compilerOptions": {
		"forceConsistentCasingInFileNames": true,
		"target": "es2019",
		"module": "commonjs",
		"moduleResolution": "node",
		"esModuleInterop": true,
		"newLine": "lf",
		"importHelpers": true,
		"noFallthroughCasesInSwitch": true,
		"noImplicitReturns": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"pretty": true,
		"removeComments": true,
		"resolveJsonModule": true,
		"sourceMap": true,
		"strict": true,
		"composite": true,
		"declaration": true,
		"rootDir": "./",
		"outDir": "./dist",
		"skipLibCheck": true
	},
	"include": ["./**/*.ts", "./**/*.json"]
}