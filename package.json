{
	"name": "TrustSECO-dlt",
	"version": "2.0.0",
	"description": "",
	"author": "Martijn &amp; Fides",
	"license": "AGLP-3.0-or-later",
	"keywords": ["blockchain", "klayr", "nodejs", "javascript", "typescript"],
	"homepage": "",
	"repository": {},
	"engines": {
		"node": ">=18.12.0 <=18",
		"npm": ">=8.1.0"
	},
	"main": "dist/index.js",
	"scripts": {
		"lint": "eslint --ext .ts .",
		"lint:fix": "eslint --fix --ext .js,.ts .",
		"format": "prettier --write '**/*'",
		"prepack": "oclif manifest && oclif readme --multi --dir=docs/commands && npm shrinkwrap && npm prune --production && npm shrinkwrap",
		"prebuild": "if test -d dist; then rm -r dist; fi; rm -f tsconfig.tsbuildinfo; rm -f npm-shrinkwrap.json",
		"build": "tsc",
		"test": "jest --passWithNoTests",
		"test:coverage": "jest --passWithNoTests --coverage=true --coverage-reporters=text",
		"test:ci": "jest --passWithNoTests --coverage=true --coverage-reporters=json",
		"version": "oclif readme --multi --dir=docs/commands && git add README.md docs",
		"prepublishOnly": "npm ci && npm run lint && npm run build",
		"genesis": "./bin/run genesis-block:create --output config/default --assets-file ./config/default/genesis_assets.json",
		"unsafe-reset": "npm run build && echo \"\n\" | ./bin/run blockchain reset",
		"reset": "npm run build && ./bin/run blockchain reset",
		"start": "npm run build && ./bin/run start --config config/default/config.json --overwrite-config"
	},
	"bin": {
		"TrustSECO": "./bin/run"
	},
	"klayr": {
		"addressPrefix": "kly"
	},
	"oclif": {
		"bin": "TrustSECO",
		"commands": "./dist/commands",
		"plugins": ["@oclif/plugin-help", "@oclif/plugin-autocomplete", "@oclif/plugin-version"],
		"additionalHelpFlags": ["-h"],
		"additionalVersionFlags": ["-v"],
		"topicSeparator": " ",
		"topics": {
			"block": {
				"description": "Commands relating to TrustSECO blocks."
			},
			"blockchain": {
				"description": "Commands relating to TrustSECO blockchain data."
			},
			"console": {
				"description": "TrustSECO interactive REPL session to run commands."
			},
			"config": {
				"description": "Commands relating to TrustSECO node configuration."
			},
			"keys": {
				"description": "Commands relating to TrustSECO key generation."
			},
			"generator": {
				"description": "Commands relating to TrustSECO block generator."
			},
			"system": {
				"description": "Commands relating to TrustSECO node."
			},
			"passphrase": {
				"description": "Commands relating to TrustSECO passphrases."
			},
			"endpoint": {
				"description": "Commands relating to TrustSECO endpoint."
			},
			"sdk": {
				"description": "Commands relating to Klayr SDK development."
			},
			"transaction": {
				"description": "Commands relating to TrustSECO transactions."
			}
		}
	},
	"files": ["/bin", "/npm-shrinkwrap.json", "/oclif.manifest.json", "/dist", "/config", "/docs"],
	"dependencies": {
		"@klayr/dashboard-plugin": "0.3.2",
		"@klayr/faucet-plugin": "0.3.2",
		"@klayr/monitor-plugin": "0.4.2",
		"@klayr/report-misbehavior-plugin": "0.4.2",
		"@klayr/chain-connector-plugin": "0.1.2",
		"@oclif/core": "1.20.4",
		"@oclif/plugin-autocomplete": "1.3.6",
		"@oclif/plugin-help": "5.1.19",
		"@oclif/plugin-version": "1.1.3",
		"axios": "0.21.2",
		"fs-extra": "11.1.0",
		"inquirer": "8.2.5",
		"klayr-commander": "6.0.2",
		"klayr-sdk": "6.0.2",
		"tar": "6.1.11",
		"tslib": "2.4.1",
		"openpgp": "^6.1.0",
		"dotenv": "^16.0.1"
	},
	"devDependencies": {
		"@oclif/test": "2.2.12",
		"@types/fs-extra": "9.0.13",
		"@types/node": "18.15.3",
		"@types/tar": "6.1.3",
		"@types/jest": "29.2.3",
		"@types/jest-when": "3.5.2",
		"@typescript-eslint/eslint-plugin": "5.44.0",
		"@typescript-eslint/parser": "5.44.0",
		"eslint": "8.28.0",
		"eslint-config-klayr-base": "2.0.1",
		"eslint-plugin-import": "2.26.0",
		"eslint-plugin-jest": "27.1.6",
		"globby": "10.0.2",
		"husky": "4.2.5",
		"jest": "29.3.1",
		"jest-extended": "3.2.0",
		"jest-when": "3.5.2",
		"oclif": "3.2.31",
		"lint-staged": "10.2.11",
		"prettier": "2.8.0",
		"ts-jest": "29.0.3",
		"ts-node": "10.9.1",
		"typescript": "5.0.2"
	}
}
